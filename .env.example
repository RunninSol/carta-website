# ─────────────────────────────────────────────────────────────
# Carta website — environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── A. CALENDLY (booking) ───────────────────────────────────
# Your PUBLIC Calendly scheduling link. No API key / OAuth needed.
# Create an event type in Calendly (e.g. "Discovery Call") and paste
# its share link here. Exposed to the browser, so it must be public.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gabe-travelbycarta/new-meeting

# ── B. INQUIRY + GUIDE EMAIL (Gmail API via OAuth2) ─────────
# Server-only values from the existing Carta Google OAuth connection.
SMTP_USER=gabe@travelbycarta.com
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Where inquiries are delivered, and the From header shown in your inbox.
CONTACT_TO=gabe@travelbycarta.com
CONTACT_FROM=Carta Website <gabe@travelbycarta.com>

# ── C. HOTEL FIT GUIDE LEAD CAPTURE (Airtable) ──────────────
# Server-only values. The API token needs record read/write access to the
# Carta CRM base. Never prefix these with NEXT_PUBLIC_.
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-carta-base-id
AIRTABLE_CLIENTS_TABLE_ID=your-clients-table-id
AIRTABLE_TASKS_TABLE_ID=your-tasks-table-id
